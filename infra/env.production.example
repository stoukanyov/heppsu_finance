# Шаблон за /srv/aifos/.env на production сървъра.
#
# НЕ комитвай попълнен вариант. Истинският файл се създава на сървъра от
# infra/deploy.sh (генерира SECRET_KEY и паролата на базата) и е chmod 600.

# ── Среда ────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
# Приложението отказва да стартира с ключа по подразбиране, когато ENVIRONMENT
# е production/staging. Ключът се генерира с: openssl rand -base64 48
SECRET_KEY=

# ── База ─────────────────────────────────────────────────────────────────────
POSTGRES_DB=aifos
POSTGRES_USER=aifos
POSTGRES_PASSWORD=
# Хостът `db` е името на услугата в compose мрежата.
DATABASE_URL=postgresql+psycopg://aifos:ПАРОЛА@db:5432/aifos
# В production схемата се управлява САМО от Alembic.
AUTO_CREATE_TABLES=false

# ── Токени ───────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
# ЗАДЪЛЖИТЕЛНО true зад nginx: иначе всички заявки изглеждат от IP-то на прокси-то
# и лимитът за неуспешни входове се изчерпва от един потребител за всички.
RATE_LIMIT_TRUST_PROXY_HEADER=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# Вграденият SPA се обслужва от същия произход, така че списъкът трябва да съдържа
# само реални външни клиенти (мобилното приложение ползва native HTTP, не CORS).
CORS_ORIGINS=["https://ДОМЕЙН"]

# ── AI ───────────────────────────────────────────────────────────────────────
# Ключът се чете САМО от средата и никога не се логва и не се връща в отговор.
# Без него приложението работи с детерминиран stub — AI функциите не се чупят.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_PROVIDER=auto

# ── Политики (човекът потвърждава, системата предлага) ────────────────────────
# Авто-осчетоводяването остава изключено, докато не се натрупа доверие в модела.
AUTO_POST_DOCUMENTS=false
AUTO_POST_MIN_CONFIDENCE=0.85
# Двойно одобрение на плащания: никой не одобрява собственото си предложение.
MAKER_CHECKER_ENABLED=true

# ── НАП ──────────────────────────────────────────────────────────────────────
# Системата подготвя пакет; подаването е ръчно с КЕП от представителя.
NRA_SUBMISSION_PROVIDER=NRA_PORTAL_PACKAGE

# ── Съхранение ───────────────────────────────────────────────────────────────
DOCUMENT_STORAGE_DIR=/app/storage/documents
PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# ── Магазини (празни = stub конектор) ────────────────────────────────────────
STORE_PROVIDER=auto
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_VENDOR_NUMBER=
GOOGLE_PLAY_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
