# Копирай като .env и коригирай при нужда.

# Локален dev (SQLite) — по подразбиране:
DATABASE_URL=sqlite:///./ai_finance_os.db
AUTO_CREATE_TABLES=true

# Production (PostgreSQL) — пример:
# DATABASE_URL=postgresql+psycopg://aifos:aifos@localhost:5432/aifos
# AUTO_CREATE_TABLES=false

# Смени в production! При ENVIRONMENT=production|prod|staging приложението ОТКАЗВА
# да стартира с този дефолт, с празен или с ключ под 32 байта.
# Генериране на силен ключ:  openssl rand -hex 32
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720
# local | development | test → облекчени проверки; production | prod | staging → строги.
ENVIRONMENT=local
# Само симетрични алгоритми (HS256/HS384/HS512); 'none' се отхвърля при старт.
# JWT_ALGORITHM=HS256

# Brute force защита на /auth/login (плъзгащ прозорец по IP + имейл, в паметта).
# RATE_LIMIT_ENABLED=true
# LOGIN_RATE_LIMIT_ATTEMPTS=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# Включи САМО ако API-то е зад доверен reverse proxy (Caddy/nginx):
# RATE_LIMIT_TRUST_PROXY_HEADER=false

DEFAULT_BASE_CURRENCY=EUR
DEFAULT_COUNTRY=BG

# AI (Anthropic). Без ключ системата ползва детерминиран stub (без реален AI).
# Задай ключа в средата, за да активираш реалния AI CFO и OCR:
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5
# AI_PROVIDER=auto   # auto|anthropic|stub
